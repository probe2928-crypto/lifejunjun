 "subs": [
  {
   "t0": 0.0,
   "t1": 2.09,
   "text": "매년 아침\n[9시 5분]",
   "y": 0.33
  },
  {
   "t0": 2.09,
   "t1": 4.52,
   "text": "튀르키예 거리가\n[멈추는] 이유, 아세요?",
   "y": 0.33
  },
  {
   "t0": 4.52,
   "t1": 7.33,
   "text": "그 이유가\n[이스탄불]의 이 궁전에"
  },
  {
   "t0": 7.33,
   "t1": 9.49,
   "text": "[1938년 11월 10일]"
  },
  {
   "t0": 9.49,
   "t1": 11.61,
   "text": "튀르키예의 국부\n[아타튀르크]가"
  },
  {
   "t0": 11.61,
   "t1": 13.8,
   "text": "이 방에서\n세상을 떠났습니다"
  },
  {
   "t0": 13.8,
   "t1": 16.45,
   "text": "그때 시각이\n아침 [9시 5분]"
  },
  {
   "t0": 16.45,
   "t1": 17.51,
   "text": "그래서\n이 방 시계는"
  },
  {
   "t0": 17.51,
   "t1": 20.21,
   "text": "지금도\n[9시 5분]에 멈춰 있어요"
  },
  {
   "t0": 20.21,
   "t1": 23.81,
   "text": "그리고 매년 그날\n그 시각이 되면"
  },
  {
   "t0": 23.81,
   "t1": 25.59,
   "text": "전국에\n[사이렌]이 울리고"
  },
  {
   "t0": 25.59,
   "t1": 27.33,
   "text": "거리의 사람도\n차도"
  },
  {
   "t0": 27.33,
   "t1": 29.23,
   "text": "그 자리에\n[멈춰 섭니다]"
  },
  {
   "t0": 32.46,
   "t1": 35.24,
   "text": "가시면 이 시계를\n꼭 찾아보세요",
   "y": 0.7
  }
 ],
