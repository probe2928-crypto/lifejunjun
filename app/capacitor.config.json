{
  "appId": "kr.lifejunjun.app",
  "appName": "인생준준",
  "webDir": "www",
  "backgroundColor": "#fffaf0",
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1500, "launchAutoHide": false, "backgroundColor": "#fffaf0", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#fffaf0" },
    "SystemBars": { "insetsHandling": "css" }
  },
  "ios": { "contentInset": "never", "backgroundColor": "#fffaf0", "scrollEnabled": true },
  "server": { "iosScheme": "capacitor" }
}
