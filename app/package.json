{
  "name": "lifejunjun-app",
  "private": true,
  "version": "1.0.0",
  "description": "인생준준 iOS 앱 (Capacitor) — 탑승(여행)·여행 카드·내 여권·라운지. 화면은 src/, 빌드는 chainbrief 저장소 '스토어 앱' Actions",
  "scripts": {
    "www": "node build-www.mjs",
    "sync": "node build-www.mjs && cap sync",
    "assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor '#2f80ed' --iconBackgroundColorDark '#2f80ed' --splashBackgroundColor '#0b1030' --splashBackgroundColorDark '#0b1030'"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
